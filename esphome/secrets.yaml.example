# =============================================================================
# Secrets Configuration Template
# =============================================================================
# Copy this file to secrets.yaml and fill in your actual values
# secrets.yaml is excluded from version control (.gitignore)
# =============================================================================

# WiFi Credentials
wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# Fallback AP Password (used when WiFi fails)
fallback_password: "fallbackAP123"

# API Encryption Key (generate with: esphome run config.yaml)
api_key: "your-32-character-api-key-here"

# OTA Update Password
ota_password: "your-ota-password-here"

# Timezone (POSIX format)
# Examples:
#   UTC: "UTC0"
#   US Eastern: "EST5EDT,M3.2.0,M11.1.0"
#   US Pacific: "PST8PDT,M3.2.0,M11.1.0"
#   Europe/London: "GMT0BST,M3.5.0/1,M10.5.0"
timezone: "UTC0"
